@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3)

# The library links dqrobotics. If the consumer has not already provided a
# dqrobotics::dqrobotics target, recreate one so the interface resolves.
if(NOT TARGET dqrobotics::dqrobotics)
    find_path(_sas_dq_inc NAMES dqrobotics/DQ.h PATHS /usr /usr/local /opt/homebrew
                HINTS ENV CMAKE_PREFIX_PATH)
    find_library(_sas_dq_lib NAMES dqrobotics PATHS /usr /usr/local /opt/homebrew
                 HINTS ENV CMAKE_PREFIX_PATH)
    if(_sas_dq_inc AND _sas_dq_lib)
        add_library(dqrobotics::dqrobotics UNKNOWN IMPORTED)
        set_target_properties(dqrobotics::dqrobotics PROPERTIES
            IMPORTED_LOCATION "${_sas_dq_lib}"
            INTERFACE_INCLUDE_DIRECTORIES "${_sas_dq_inc}")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/marinholab_sas_core-targets.cmake")

check_required_components(marinholab_sas_core)
